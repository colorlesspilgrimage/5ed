// Command Mapping
// ""                - Leave the bindings unaltered - use this when writing your own customization!
// "choose"          - Same as "default".
// "default"         - Use the default keybindings.
mapping = "";

// MODE
// "5ed"          - Cursor and mark (the original mode)
// "notepad-like" - Single "thin" cursor and highlight ranges like in notepad, sublime, notepad++, etc
mode = "5ed";
bind_by_physical_key = false;

// UI
use_file_bars = true;
hide_file_bar_in_ui = true;
use_error_highlight = true;
use_jump_highlight = true;
use_scope_highlight = true;
use_paren_helper = true;
use_comment_keywords = true;
lister_whole_word_backspace_when_modified = true;
show_line_number_margins = false;
enable_output_wrapping = false;

enable_undo_fade_out = true;

// cursor_roundness is 0 to 50.
// It is the corner radius as a percent of width.
// 50 makes each side a half circle.
cursor_roundness = 45;

// mark_thickness is the mark box width in pixels.
mark_thickness = 2;

// lister_roundness is 0 to 50.
// It is the corner radius as a percent of height.
lister_roundness = 20;

// Code Wrapping
treat_as_code = ".cpp.c.hpp.h.cc.cs.java.rs.glsl.m.mm";
enable_virtual_whitespace = true;
virtual_whitespace_regular_indent = 4;
enable_code_wrapping = true;

// This setting applies only to code files in code-wrapping mode.
// Plain text files do not use it.
// Code files without virtual whitespace do not use it.
automatically_indent_text_on_save = true;

// When set to true, all unsaved changes will be saved on a build.
automatically_save_changes_on_build = true;

// Load project on startup
automatically_load_project = false;

// Indentation
indent_with_tabs = false;
indent_width = 4;
default_tab_width = 4;

// Theme
default_theme_name = "5ed";

// Font
default_font_name = "liberation-mono.ttf";
default_font_size = 16;
default_font_hinting = false;

// aa modes:
//  8bit - mono-chrome 0-255 opacity channel per pixel
//  1bit - mono-chrome 0/1 opacity channel per pixel
default_font_aa_mode = "8bit";

// User
user_name = "not-set";

// Keyboard AltGr setting
lalt_lctrl_is_altgr = false;

// Project setup configuration
default_compiler_sh = "g++";
default_flags_sh  = "-g";

