version(2);
project_name = "5ed";

patterns = {
 "*.c",
 "*.cpp",
 "*.h",
 "*.txt",
 "*.5ed",
 "CMakeLists.txt",
};
blacklist_patterns = {
 ".*",
};

load_paths = {
 .linux = {
  { .path = ".", .recursive = true, .relative = true, },
 },
};

commands = {
 .build = {
  .linux = "cmake -S . -B build && cmake --build build -j",
  .out = "*compilation*",
  .footer_panel = true,
  .save_dirty_files = true,
  .cursor_at_end = false,
 },
 .run = {
  .linux = "build/5ed",
  .out = "*run*",
  .footer_panel = false,
  .save_dirty_files = false,
  .cursor_at_end = false,
 },
 .regen = {
  .linux = "cmake --build build --target regen -j",
  .out = "*compilation*",
  .footer_panel = true,
  .save_dirty_files = true,
  .cursor_at_end = false,
 },
};

fkey_command = {
 .F1 = "build",
 .F2 = "run",
};
